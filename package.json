{
  "name": "auto-bookmarks",
  "displayName": "Auto Bookmarks",
  "description": "Automatically find configured text markers and navigate grouped occurrences from the Activity Bar.",
  "version": "2.3.0",
  "publisher": "skravciv",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:autoBookmarksView",
    "onCommand:autoBookmarks.openSettings",
    "onCommand:autoBookmarks.addSelectedText"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autoBookmarks.refresh",
        "title": "Auto Bookmarks: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "autoBookmarks.openSettings",
        "title": "Auto Bookmarks: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "autoBookmarks.addSelectedText",
        "title": "Auto Bookmarks: Add Selected Text"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "autoBookmarks.addSelectedText",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "autoBookmarks.refresh",
          "when": "view == autoBookmarksView",
          "group": "navigation@1"
        },
        {
          "command": "autoBookmarks.openSettings",
          "when": "view == autoBookmarksView",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoBookmarksContainer",
          "title": "Auto Bookmarks",
          "icon": "media/bookmark.svg"
        }
      ]
    },
    "views": {
      "autoBookmarksContainer": [
        {
          "id": "autoBookmarksView",
          "name": "Bookmarks",
          "icon": "media/bookmark.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "autoBookmarksView",
        "contents": "No bookmarks found in the active file.\n[Open Settings](command:autoBookmarks.openSettings)\n[Refresh](command:autoBookmarks.refresh)"
      }
    ],
    "configuration": {
      "title": "Auto Bookmarks",
      "properties": {
        "autoBookmarks.searchTexts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Deprecated. Moved into autoBookmarks.documentationLinks (text, color, url); existing values are migrated automatically.",
          "deprecationMessage": "Deprecated: use autoBookmarks.documentationLinks instead."
        },
        "autoBookmarks.fileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".js",
            ".ts",
            ".jsx",
            ".tsx",
            ".json",
            ".html",
            ".css",
            ".xml"
          ],
          "description": "Extensions to scan. Empty means all file types."
        },
        "autoBookmarks.caseSensitive": {
          "type": "boolean",
          "default": true,
          "description": "Use case-sensitive matching."
        },
        "autoBookmarks.colors": {
          "type": "object",
          "default": {},
          "description": "Deprecated. Colors are now set per entry in autoBookmarks.documentationLinks; existing values are migrated automatically.",
          "deprecationMessage": "Deprecated: use autoBookmarks.documentationLinks instead."
        },
        "autoBookmarks.maxFileSizeMB": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Maximum file size in MB that Auto Bookmarks will scan. Set to 0 to disable the limit."
        },
        "autoBookmarks.documentationLinks": {
          "type": "array",
          "default": [
            {
              "text": "TODO",
              "color": "#fbbf24"
            },
            {
              "text": "FIXME",
              "color": "#f87171"
            },
            {
              "text": "GlideRecord",
              "color": "#38bdf8"
            }
          ],
          "description": "Bookmarks: text to find in the active file, an optional highlight color and an optional documentation URL. Entries with an http(s) URL also show an \"Open Documentation\" lightbulb when the cursor is on an exact match.",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "Text to find (exact, whole word for the documentation lightbulb)."
              },
              "color": {
                "type": "string",
                "description": "Highlight color for the matching line numbers, for example #38bdf8."
              },
              "url": {
                "type": "string",
                "description": "Optional http(s) documentation URL opened by the Quick Fix."
              }
            },
            "required": [
              "text"
            ]
          }
        }
      }
    }
  },
  "license": "MIT"
}
